{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/otak(/.*)?",
      "dest": "/api/otak.py"
    },
    {
      "src": "/api/state",
      "dest": "/api/state.py"
    },
    {
      "src": "/api/tick",
      "dest": "/api/tick.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}