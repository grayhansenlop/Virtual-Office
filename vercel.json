{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/otak.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/otak(/.*)?",
      "dest": "/api/otak.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}